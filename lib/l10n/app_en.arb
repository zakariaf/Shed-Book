    "description": "The presentation_note field's label, and it is DELIBERATELY SPECIFIC. Spec 7.2 lists lubricant/ropes/vet under assistance detail; 03 5.4 ships no column for it and the schema froze at N07-T08, so it lands here as free text. The label names the three so the next reader does not go looking for a column or propose one. A structured version is a v2 migration, not a widget."
  },
  "detailNote": "ANYTHING ELSE",
  "@detailNote": {
    "description": "The lambing's own note column. Distinct from a notes ROW, which is the attachment-bearing kind NoteRepository owns."
  },
  "detailUnset": "NOT RECORDED · SKIPPABLE",
  "@detailUnset": {
    "description": "Every detail field's unset state. SKIPPABLE is on the line because a shepherd at 03:20 needs to know they may walk away without answering - the tally is the record, and everything after it is detail. Never a placeholder inside the field (indelible.md 7.12): in the dark a grey placeholder is indistinguishable from an entered value."
  },
  "detailPresentationSemantics": "How it was lying, not required",
  "@detailPresentationSemantics": {
    "description": "The presentation group's container label. It says the field may be skipped and does NOT say which word is selected - the buttons carry `selected` and a screen reader announces state itself (10 3.2 rule 2)."
  },
  "lambCardTitle": "{animal}",
  "@lambCardTitle": {
    "description": "The Lamb Card's heading, headingLevel 1. It is the animal noun and the tag when there is one - never 'Lamb details' or 'Lamb record', because the shepherd came here from a row that already said which lamb.",
    "placeholders": {
      "animal": {
        "type": "String"
      }
    }
  },
  "lambCardBirthDam": "BIRTH DAM {tag}",
  "@lambCardBirthDam": {
    "description": "The birth dam row. A lamb has ONE birth dam, forever - no verb in the app moves it. A foster moves the REARING dam, and making a foster look like a rewrite of history is the failure the lamb_rearing view exists to prevent.",
    "placeholders": {
      "tag": {
        "type": "String"
      }
    }
  },
  "lambCardRearingDam": "REARING DAM {tag}",
  "@lambCardRearingDam": {
    "description": "The rearing dam row, projected by the lamb_rearing view and never copied onto the lamb. On an unfostered lamb it is the birth dam, which is what the view's COALESCE says and is NOT the same as having no rearing dam.",
    "placeholders": {
      "tag": {
        "type": "String"
      }
    }
  },
  "lambCardPermanent": "PERMANENT",
  "@lambCardPermanent": {
    "description": "Marks a foster whose outcome was recorded as permanent. It is a fact about the foster event, never a judgement about the lamb."
  },
  "lambCardNoEweBottle": "ON THE BOTTLE",
  "@lambCardNoEweBottle": {
    "description": "One of the TWO reasons a rearing dam can be absent, and 07 7.2 forbids rendering them with one string. This one is a fact the shepherd recorded: the lamb came off a ewe and onto a bottle."
  },
  "lambCardNoEweNotRecorded": "REARING DAM NOT RECORDED",
  "@lambCardNoEweNotRecorded": {
    "description": "The OTHER reason a rearing dam can be absent: the lamb was removed from a ewe and where it went was not recorded. Merging this with ON THE BOTTLE would have the app claim a bottle feed that nobody wrote down."
  },
  "lambCardNothingElseRecorded": "NOTHING ELSE RECORDED YET",
  "@lambCardNothingElseRecorded": {
    "description": "The history list when only the birth row exists. NOT an empty state - the born row is always there, because a lamb that exists was born. It says nothing ELSE, which is the true statement."
  },
  "lambCardUntagged": "UNTAGGED",
  "@lambCardUntagged": {
    "description": "A lamb with no tag yet, which is most lambs for most of their first week. Never a blank and never a generated number: a tag the app invented would be a tag on no ear."
  },
  "lambCardHistoryBorn": "BORN",
  "@lambCardHistoryBorn": {
    "description": "The 'born' arm of the history union. Always present - it is the one row a lamb card can never be missing."
  },
  "lambCardHistoryFoster": "FOSTERED",
  "@lambCardHistoryFoster": {
    "description": "The 'foster' arm. Past tense because it is an event that happened, not a state the lamb is in."
  },
  "lambCardHistoryCare": "CARE",
  "@lambCardHistoryCare": {
    "description": "The 'care' arm - a care event recorded against this lamb rather than against the lambing."
  },
  "lambCardHistoryTreatment": "TREATMENT",
  "@lambCardHistoryTreatment": {
    "description": "The 'treatment' arm. The withdrawal that may hang off it is the treatment record's own business and is never summarised here."
  },
  "lambCardSexLabel": "SEX",
  "@lambCardSexLabel": {
    "description": "The sex group's label on the Lamb Card. Three targets, not two: not-recorded is reached by clearing, and recorded-as-unknown is its own answer."
  },
  "lambCardSexUnknown": "COULD NOT TELL",
  "@lambCardSexUnknown": {
    "description": "Sex.unknown, and the words are chosen to be UNMISTAKABLE for not-recorded (R45). The shepherd LOOKED and could not say - which is a fact worth keeping, and merging it with an empty field would have the app answer a question they deliberately left open. Never 'Unknown' alone, which reads like a missing value."
  },
  "lambCardWeightLabel": "BIRTHWEIGHT",
  "@lambCardWeightLabel": {
    "description": "The weight cell's label, above the line. One word, the trade's own."
  },
  "lambCardWeightUnset": "NOT RECORDED · SKIPPABLE",
  "@lambCardWeightUnset": {
    "description": "The weight cell before anything is typed. Never a zero and never a placeholder figure: 05 7.3 - the app may transform a number the shepherd supplied, never originate one."
  },
  "lambCardWeightUnitKg": "kg",
  "@lambCardWeightUnitKg": {
    "description": "The kg suffix beside the weight keypad. The unit comes from unitsProvider (R68), never from the locale: a UK smallholder may genuinely want lb, and a wrong inference silently mislabels every weight ever recorded."
  },
  "lambCardWeightUnitLb": "lb",
  "@lambCardWeightUnitLb": {
    "description": "The lb suffix. Entry is in whole pounds and the decimal key adds a fraction of one; the decomposition into ounces happens at display, where poundsOunces rounds once and carries at sixteen."
  },
  "warningImplausibleBirthWeight": "That is outside the usual birthweight range.",
  "@warningImplausibleBirthWeight": {
    "description": "The implausible-birthweight observation. It says WHAT WE OBSERVED and never what to do - a warning that instructs is advice (12.2) and a warning that changes a value is a correction (12.4). It NEVER blocks the write: a blocked write produces a lost record, which is worse than a queried one. Never 'too heavy', never 'please check', never a suggested figure. It also carries NO ANIMAL NOUN: 10 8.5 keeps domain nouns out of sentences because they vary by county, and l10n_bootstrap_test.dart caught the first draft of this message for saying 'for a lamb'. There is no placeholder to use here either, because the string is a Warning.message from lib/domain/, which cannot reach terminologyProvider."
  },
  "lambCardStatusLabel": "STATUS",
  "@lambCardStatusLabel": {
    "description": "The status group's label. Three targets - alive, dead, stillborn - because those are the three the shepherd records at the shed. SOLD is set elsewhere, from the flock list, and putting it here would offer a sale as a thing that happens in a lambing pen."
  },
  "lambCardDeathDateLabel": "WHEN",
  "@lambCardDeathDateLabel": {
    "description": "The death date's label. One word, because the three quick answers under it carry the meaning."
  },
  "lambCardDeathDateToday": "TODAY",
  "@lambCardDeathDateToday": {
    "description": "The commonest answer, first. A death recorded at the shed is almost always today's, and 07 7.3 puts the three quick answers ahead of the stepper so the usual case is one tap."
  },
  "lambCardDeathDateYesterday": "YESTERDAY",
  "@lambCardDeathDateYesterday": {
    "description": "The second quick answer. It exists because a shepherd who finds a dead lamb at 06:00 often means the night before."
  },
  "lambCardDeathDateTwoDaysAgo": "2 DAYS AGO",
  "@lambCardDeathDateTwoDaysAgo": {
    "description": "The third quick answer, and the last: beyond this the stepper is more honest than another word, because 'THREE DAYS AGO' and 'FOUR DAYS AGO' are guesses dressed as buttons."
  },
  "lambCardDeathCauseLabel": "CAUSE",
  "@lambCardDeathCauseLabel": {
    "description": "The death cause's label. The list is user-editable vocabulary (vocab_terms, list='death_cause'), never a fixed enum: causes vary by farm and by county."
  },
  "lambCardDeathCauseUnattributed": "NOT RECORDED",
  "@lambCardDeathCauseUnattributed": {
    "description": "No cause recorded. This is UNATTRIBUTED, and it is NOT the same as the dc_unknown term the shepherd can pick - a lamb died and nobody wrote down why is a different fact from a lamb died and the shepherd recorded that the cause was unknown. The vocabulary keeps them apart and so does this label."
  },
  "warningDeathBeforeBirth": "The death date is before the lambing.",
  "@warningDeathBeforeBirth": {
    "description": "The deathBeforeBirth observation, and it is the ARB copy of a string the domain also holds - lib/domain/ ships English because v1 is en-only (#108). It says what we observed and never what to do: it does not say 'check the date' and it does not offer to swap them. It never blocks the write, because a blocked write produces a lost record and this one is about a lamb that died."
  },
  "lambCardPetLambLabel": "ON THE BOTTLE",
  "@lambCardPetLambLabel": {
    "description": "The pet-lamb toggle's label. The trade phrase, not 'Pet lamb status': a shepherd says a lamb is on the bottle. Clearing it does NOT zero the feed count - which lambs cost six weeks of bottles is exactly the April question, and a lamb weaned off the bottle is still a lamb that was on it."
  },
  "lambCardFeedsLabel": "FEEDS",
  "@lambCardFeedsLabel": {
    "description": "The bottle-feed counter's label. It counts feeds, and the total is the stored fact: indelible.md 8 asks for a timestamped FEED 4 - 06:40 line per feed, and no table can hold one (care_events.kind is a closed CHECK wired to frozen notification channel ids). Printing that line from a counter would invent a timestamp the record does not have."
  },
  "lambCardFeedsUnset": "NOT RECORDED · SKIPPABLE",
  "@lambCardFeedsUnset": {
    "description": "The feed count before the lamb is marked as on the bottle. It is NOT a zero: bottle_feeds has DEFAULT 0 and that column's 0 means 'no feeds recorded', while pet_lamb is what says whether the count is meaningful at all. A confident 0 on a lamb nobody bottle-fed would be the app originating a number the shepherd never pressed."
  },
  "lambCardFeedsAdd": "+",
  "@lambCardFeedsAdd": {
    "description": "The increment target's glyph. There is no minus: a feed that happened cannot un-happen, and a decrement would be an undo for an event rather than a correction of a value. If a mis-tap needs undoing that is a screens decision, not a local one."
  },
  "lambCardFeedsAddSemantics": "Record one more bottle feed",
  "@lambCardFeedsAddSemantics": {
    "description": "The increment target for a screen reader. A bare '+' is unreadable aloud, and the label says what is counted."
  },
  "fosterTitle": "FOSTER",
  "@fosterTitle": {
    "description": "The Foster screen's heading, headingLevel 1. The verb, not 'Foster lamb' - the shepherd arrived here from a lamb and already knows which one."
  },
  "fosterOnto": "ONTO {tag}",
  "@fosterOnto": {
    "description": "One ewe target in the match list. ONE TAP COMMITS - there is no confirm step, because 07 8.2's budget is one tap and spec 7.3 names this as the flow most likely to be abandoned if it takes five. The tag is the ewe's, and it is what the shepherd reads off the ear.",
    "placeholders": {
      "tag": {
        "type": "String"
      }
    }
  },
  "fosterToBottle": "ONTO THE BOTTLE",
  "@fosterToBottle": {
    "description": "The to_bottle outcome, and it is a DELIBERATE fact: the shepherd put this lamb on a bottle. It is NOT the same as the removed-from-a-ewe outcome beside it, and merging the two would change a season's rearing-credit figures silently - which is why setRearingDam(LambId, EweId?) is a banned signature (07 8.4 rule 1)."
  },
  "fosterRemovedUnknown": "OFF THE {animal} · WHERE NOT RECORDED",
  "@fosterRemovedUnknown": {
    "description": "The removed_unknown outcome. The lamb came off a ewe and where it went was not written down - null BY OMISSION, where the bottle outcome is null BY INTENT. The label says both halves out loud so the two can never be read as the same button. The animal noun is a PLACEHOLDER: 10 8.5 keeps domain nouns out of sentences because they vary by county, and l10n_bootstrap_test.dart caught the first draft of this message for spelling it.",
    "placeholders": {
      "animal": {
        "type": "String"
      }
    }
  },
  "fosterNoMatch": "NO MATCH YET",
  "@fosterNoMatch": {
    "description": "The match list before enough digits are typed. NOT an error and NOT an empty state: the shepherd is mid-tag, and a screen that said 'not found' after two digits would be arguing with someone who has not finished."
  },
  "fosterBirthDamNote": "BIRTH DAM {tag} · UNCHANGED",
  "@fosterBirthDamNote": {
    "description": "Printed on the Foster screen so the shepherd can see that fostering does not rewrite the birth dam. It is the product's own promise made visible at the moment it matters: a lamb has one birth dam forever, and lamb_birth_dam_is_immutable is the trigger that holds it.",
    "placeholders": {
      "tag": {
        "type": "String"
      }
    }
  },
  "warningFosterToSelf": "That {animal} is already on this {dam}.",
  "@warningFosterToSelf": {
    "description": "The fosterToSelf observation. It says WHAT WE OBSERVED and never what to do, and it NEVER blocks: fostering a lamb onto the ewe she is already on is a thing a shepherd does at 03:20 by mistake, and refusing it would lose the record of an action they took. The comparison is against the CURRENT REARING DAM, never the birth dam - after a foster to B, fostering the lamb back to her birth dam is not a self-foster at all. BOTH nouns are placeholders: 10 8.5 keeps domain nouns out of sentences because they vary by county, and l10n_bootstrap_test.dart caught the first draft for spelling 'ewe'.",
    "placeholders": {
      "animal": {
        "type": "String"
      },
      "dam": {
        "type": "String"
      }
    }
  },
  "penTileHours": "{hours}h",
  "@penTileHours": {
    "description": "The elapsed-hours readout on a pen tile. Truncated, never rounded: a ewe penned 59 minutes ago has been in there for 0h, and the readout is only worth having if it is not flattering. Tabular figures, so twelve tiles line up.",
    "placeholders": {
      "hours": {
        "type": "int"
      }
    }
  },
  "penTileReady": "READY",
  "@penTileReady": {
    "description": "The ready status word. It means settled for at least the SHEPHERD'S OWN threshold - never a recommendation to turn out, which would be advice (12.2). The dagger in the margin and the doubled rule carry the same fact without colour."
  },
  "penTileAttention": "CLEAR {date}",
  "@penTileAttention": {
    "description": "The attention status. It prints the withdrawal's CLEAR DATE, which is the fact the shepherd needs - never 'do not turn out', which would be an instruction. Attention outranks ready because turning out a ewe still under withdrawal is the mistake this app exists to prevent.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "penTileLoss": "DEAD",
  "@penTileLoss": {
    "description": "The loss status word, printed in full ink in the lamb column. It carries NO COLOUR CHANNEL AT ALL, ever: a colour-coded death reads wrong at 4am through a wet freezer bag, and 10 5.2 has no status palette to use anyway."
  },
  "penTileEmpty": "— empty —",
  "@penTileEmpty": {
    "description": "An empty pen. It is a STATUS, not an absence - the pen with nothing in it is the pen the shepherd is about to use, so it is drawn rather than omitted. The dotted rule where the value would be is the second channel."
  },
  "penTileSemantics": "Pen {label}, {state}",
  "@penTileSemantics": {
    "description": "One tile as one utterance. The label is the number chalked on the hurdle; the state is the same words the eye gets, so a support call about 'pen 3' is about the same thing for both users.",
    "placeholders": {
      "label": {
        "type": "String"
      },
      "state": {
        "type": "String"
      }
    }
  },
  "penBoardAddPen": "+ PEN",
  "@penBoardAddPen": {
    "description": "The add-pen target. ONE TAP, no wizard and no naming step: the shepherd is standing in front of a pen at 03:20 and asking what to call it is asking for a decision they do not have. The number is chosen for them and renaming happens in daylight."
  },
  "penBoardAddPenSemantics": "Add a pen",
  "@penBoardAddPenSemantics": {
    "description": "The add-pen target for a screen reader. A bare plus is unreadable aloud."
  },
  "penBoardTitle": "PENS",
  "@penBoardTitle": {
    "description": "The pen board grid container label. One word: the shepherd got here from a named destination and the tiles carry the meaning."
  },
  "withdrawalLabel": "WITHDRAWAL — {target}",
  "@withdrawalLabel": {
    "description": "The withdrawal control's label. The target is meat or milk and they are asked separately, because one entered period implies nothing about the other. Never 'withholding', never 'WHP', never 'the days' - CONVENTIONS 5 fixes the word.",
    "placeholders": {
      "target": {
        "type": "String"
      }
    }
  },
  "withdrawalTargetMeat": "MEAT",
  "@withdrawalTargetMeat": {
    "description": "WithdrawalTarget.meat. The stored key is 'meat'."
  },
  "withdrawalTargetMilk": "MILK",
  "@withdrawalTargetMilk": {
    "description": "WithdrawalTarget.milk. The stored key is 'milk'. R75 keeps it in the v1 schema even though few flocks milk."
  },
  "withdrawalEnterDays": "DAYS OFF THE BOTTLE",
  "@withdrawalEnterDays": {
    "description": "The days choice. The label names WHERE THE NUMBER COMES FROM - the bottle in the shepherd's hand - because 12.1 is that the app never originates one. There is no placeholder inside the field and no prefill: in the dark a grey figure is indistinguishable from an entered one, and a prefilled 28 is a clinical decision the app made."
  },
  "withdrawalNotApplicable": "NONE APPLIES",
  "@withdrawalNotApplicable": {
    "description": "WithdrawalNotApplicable - the label says no withdrawal applies. It is a RECORDED FACT, something the shepherd read, and NOT the same as nobody writing a number down."
  },
  "withdrawalNotRecorded": "NOT RECORDED",
  "@withdrawalNotRecorded": {
    "description": "WithdrawalNotRecorded. Absence IS the state and it stores no row at all. It is NOT pre-selected: a control that pre-selects this is as wrong as one that prefills 28, because it makes a decision the shepherd did not make."
  },
  "withdrawalUnit": "days",
  "@withdrawalUnit": {
    "description": "The unit beside the days keypad. Days, always - 05 4.4 fixes the unit even for milk, where a different milking frequency could be argued, because one unit is one thing to get wrong."
  },
  "withdrawalDisagrees": "Nothing has been changed. The stored clear date is shown first; the second is what today's arithmetic gives.",
  "@withdrawalDisagrees": {
    "description": "Printed when the stored clear date and a recomputation disagree - which happens when the device changed timezone between the write and the read. BOTH numbers are shown and NEITHER is updated: 12.4 forbids silently correcting a user's entry, and the stored one is what the shepherd was told and may have written in a book. The line says nothing was changed, in as many words, and there is no control offering to reconcile them - offering would make the app the arbiter of a clinical date."
  },
  "withdrawalStored": "STORED {date}",
  "@withdrawalStored": {
    "description": "Labels the stored clear date, which renders FIRST because it is the one the shepherd was told and the one in the book.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "withdrawalRecomputed": "TODAY'S ARITHMETIC {date}",
  "@withdrawalRecomputed": {
    "description": "Labels the recomputed date, shown second and only when it disagrees. It is an observation, never an offer: there is no button beside it."
  },
  "treatmentsTitle": "TREATMENTS",
  "@treatmentsTitle": {
    "description": "The screen's heading, headingLevel 1."
  },
  "treatmentsModeCountdown": "RUNNING",
  "@treatmentsModeCountdown": {
    "description": "The countdown segment. It shows what is still under withdrawal - the question at the gate, 'can she go?'. It is the segment the screen OPENS on, because the book is what they open in the office. Never 'Active' and never 'Current': running is what a withdrawal does."
  },
  "treatmentsModeBook": "BOOK",
  "@treatmentsModeBook": {
    "description": "The medicine-book segment. indelible.md 8 screen 8: the book is not a separate view, it is the book filtered to treatments. It shows voided rows too, struck and marked, because a voided treatment may already be printed in a book handed to a vet."
  },
  "treatmentsVoided": "VOIDED {date}",
  "@treatmentsVoided": {
    "description": "The voided stamp in book mode. The row STAYS and is struck rather than removed - 12.3 and 09 3.2: the export marks voided rows rather than dropping them, because the app must never disagree with a book somebody already has.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "treatmentsClears": "CLEARS {date}",
  "@treatmentsClears": {
    "description": "The countdown line. It prints the STORED clear date and never recomputes one. There is no 'she is clear' copy anywhere: leaving the countdown is not the same as claiming a negative, and only the shepherd and their vet can say the second.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "treatmentsNoWithdrawal": "NOT RECORDED",
  "@treatmentsNoWithdrawal": {
    "description": "WithdrawalUnknown on a treatment row - no withdrawal row exists at all. Absence IS the state (12.1) and it says so - it does NOT say the animal is clear, which would be the app answering a clinical question nobody asked it. 10 5.2 names this word: NOT RECORDED, never 0 and never blank. It is NOT the same as treatmentsNotApplicable, and the row that printed one sentence for both was the defect that split them."
  },
  "treatmentsCountdown": "{tag} · {target}",
  "@treatmentsCountdown": {
    "description": "The line above a countdown, naming WHO and WHICH TARGET. The target is spelled on every countdown because one product routinely prints a meat figure and a milk figure, and a countdown with no target named is a number a shepherd could apply to the wrong one.",
    "placeholders": {
      "tag": {
        "type": "String"
      },
      "target": {
        "type": "String"
      }
    }
  },
  "treatmentsCountdownSemantics": "{tag}, {target}, {product}, clears {date}",
  "@treatmentsCountdownSemantics": {
    "description": "The spoken form of one countdown row. It does NOT speak the day tally - the tally and the figure are the same fact in two channels, and a screen reader that read both would say the number twice.",
    "placeholders": {
      "tag": {
        "type": "String"
      },
      "target": {
        "type": "String"
      },
      "product": {
        "type": "String"
      },
      "date": {
        "type": "String"
      }
    }
  },
  "treatmentsNotApplicable": "NOT APPLICABLE",
  "@treatmentsNotApplicable": {
    "description": "NoWithdrawal on a treatment row - the shepherd read the label and it said none applies. A RECORDED FACT, and the whole reason it cannot share a word with treatmentsNoWithdrawal: one is something somebody read, the other is a gap nobody filled. 10 5.2 row 8."
  },
  "treatmentsRepeatLast": "REPEAT LAST",
  "@treatmentsRepeatLast": {
    "description": "Opens the repeat flow. It shows the previous entry WITH its provenance so the shepherd can read what they entered last time, and the withdrawal days are NOT carried across - copying them would make the app the source of a clinical figure for a treatment nobody read a label for (12.1)."
  },
  "treatmentsRepeatOnto": "ONTO {tag}",
  "@treatmentsRepeatOnto": {
    "description": "One animal target in the repeat flow. One tap commits, which is the second of the two taps 07 10 budgets.",
    "placeholders": {
      "tag": {
        "type": "String"
      }
    }
  },
  "treatmentsEmpty": "NOTHING RECORDED YET",
  "@treatmentsEmpty": {
    "description": "The empty state. Not an error and not a prompt: a flock that has treated nothing has treated nothing, and the screen says so rather than inviting them to start."
  },
  "treatmentsUntagged": "UNTAGGED",
  "@treatmentsUntagged": {
    "description": "A treatment on a lamb with no tag yet, which is most lambs for most of their first week. Never a blank and never a generated number."
  }
}
