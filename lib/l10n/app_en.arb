  "nAnimals": "{count, plural, =0{No {pluralTerm}} =1{1 {singularTerm}} other{{count} {pluralTerm}}}",
  "@nAnimals": {
    "description": "ICU cannot pluralise a runtime string, so it chooses only the CATEGORY and the terminology map supplies both forms. \"{count, plural, other{{count} {term}s}}\" yields \"3 gimmers\" (fine), \"3 tups\" (fine) and \"3 sheeps\" (not fine). Both terms are USER-EDITABLE nouns from the terminology overlay: never translate them, never hard-code them. See 10-accessibility-and-i18n.md §8.5.",
    "placeholders": {
      "count": {
        "type": "num"
      },
      "singularTerm": {
        "type": "String",
        "example": "ewe"
      },
      "pluralTerm": {
        "type": "String",
        "example": "ewes"
      }
    }
  },
