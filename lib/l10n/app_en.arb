        "type": "String"
      },
      "treatments": {
        "type": "int"
      }
    }
  },
  "exportNeverExported": "Nothing has been exported from this phone yet.",
  "@exportNeverExported": {
    "description": "The honest status line before the first export. It does NOT say 'a lost phone is lost data' - that wording is banned unqualified - and it does not nag; it states a fact the shepherd can act on."
  },
  "exportLastExported": "Last exported {date}.",
  "@exportLastExported": {
    "description": "The honest status line after an export. It is the date the SHARE SHEET reported, not the date the file was written: a file assembled and then dismissed did not leave the phone.",
