import 'tables/lambing.dart';

-- lib/core/db/triggers.drift — 03 §7.
--
-- The import above is what lets drift ORDER this after the table it fires on.
-- Without it, createAll() emits the trigger before lambs exists and every test
-- in this epic fails on "no such table: main.lambs" — measured, not feared.
--
-- The one thing in this schema that is enforced by SQLite rather than by Dart,
-- and the reason is the same reason `birth_dam` exists at all: a Dart guard is
-- one repository method away from being bypassed, and a lamb whose birth dam
-- moved has lost the fact the two-dam model exists to keep. Fostering changes
-- the REARING dam; the birth dam is a fact about a birth that happened.
--
-- `IS NOT` rather than `<>`, so a change to or from NULL is caught too.
CREATE TRIGGER lamb_birth_dam_is_immutable
BEFORE UPDATE OF birth_dam ON lambs
WHEN old.birth_dam IS NOT new.birth_dam
BEGIN
  SELECT RAISE(ABORT, 'birth_dam is immutable; record a foster instead');
END;
