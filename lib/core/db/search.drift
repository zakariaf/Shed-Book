import 'tables/ancillary.dart';
import 'tables/flock.dart';
import 'tables/lambing.dart';
import 'tables/treatments.dart';

-- lib/core/db/search.drift — 03 §9.2.
--
-- FTS5 cannot be declared in Dart, so the whole search subsystem lives here.
-- One MATCH, one bm25() ordering, one snippet().
--
-- The imports above are what let drift order these AFTER the tables their
-- triggers fire on. Measured at N07-T04: without one, createAll() emits a
-- trigger before its table exists and every test fails on "no such table".

CREATE TABLE search_docs (
  id           INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  subject_kind TEXT    NOT NULL,
  subject_id   INTEGER NOT NULL,
  ewe_id       INTEGER,
  season_id    INTEGER,
  title        TEXT    NOT NULL,
  body         TEXT    NOT NULL,
  occurred_at  INTEGER NOT NULL,
  UNIQUE (subject_kind, subject_id)
) STRICT;

CREATE VIRTUAL TABLE search_fts USING fts5(
  title,
  body,
  content='search_docs',
  content_rowid='id',
  tokenize='porter unicode61 remove_diacritics 2',
  prefix='2 3'
);

-- The three sqlite.org external-content sync triggers. Contentless FTS5 does
-- not maintain itself; these are the documented shape and are not ours to
-- improve.
CREATE TRIGGER search_docs_ai AFTER INSERT ON search_docs BEGIN
  INSERT INTO search_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
END;

CREATE TRIGGER search_docs_ad AFTER DELETE ON search_docs BEGIN
  INSERT INTO search_fts(search_fts, rowid, title, body)
  VALUES ('delete', old.id, old.title, old.body);
END;

CREATE TRIGGER search_docs_au AFTER UPDATE ON search_docs BEGIN
  INSERT INTO search_fts(search_fts, rowid, title, body)
  VALUES ('delete', old.id, old.title, old.body);
  INSERT INTO search_fts(rowid, title, body) VALUES (new.id, new.title, new.body);
END;

-- The five source-table trios. The index stays in step through SQL TRIGGERS, not
-- Dart: a Dart projection is one repository method away from being skipped, and
-- a note that is not in the index is a note the shepherd cannot find.

-- notes. `new.occurred_at`, NOT `new.created_at`: the timeline sorts on when the
-- thing happened, not on when the row was written (§4.2, R37).
CREATE TRIGGER notes_search_ai AFTER INSERT ON notes BEGIN
  INSERT INTO search_docs (subject_kind, subject_id, ewe_id, season_id,
                           title, body, occurred_at)
  VALUES ('note', new.id, new.ewe, new.season, 'note',
          COALESCE(new.body, ''), new.occurred_at);
END;

CREATE TRIGGER notes_search_au AFTER UPDATE OF body ON notes BEGIN
  UPDATE search_docs SET body = COALESCE(new.body, '')
   WHERE subject_kind = 'note' AND subject_id = new.id;
END;

CREATE TRIGGER notes_search_ad AFTER DELETE ON notes BEGIN
  DELETE FROM search_docs WHERE subject_kind = 'note' AND subject_id = old.id;
END;

-- ewes. Title is the tag; body is her notes. COALESCE everywhere, because a
-- NULL body would make search_docs.body violate NOT NULL and abort the insert
-- the shepherd was actually doing.
CREATE TRIGGER ewes_search_ai AFTER INSERT ON ewes BEGIN
  INSERT INTO search_docs (subject_kind, subject_id, ewe_id, season_id,
                           title, body, occurred_at)
  VALUES ('ewe', new.id, new.id, NULL, new.tag,
          COALESCE(new.notes, ''), new.created_at);
END;

CREATE TRIGGER ewes_search_au AFTER UPDATE OF tag, notes ON ewes BEGIN
  UPDATE search_docs SET title = new.tag, body = COALESCE(new.notes, '')
   WHERE subject_kind = 'ewe' AND subject_id = new.id;
END;

CREATE TRIGGER ewes_search_ad AFTER DELETE ON ewes BEGIN
  DELETE FROM search_docs WHERE subject_kind = 'ewe' AND subject_id = old.id;
END;

-- lambings. Title is tag + local date; body is the three free-text fields.
CREATE TRIGGER lambings_search_ai AFTER INSERT ON lambings BEGIN
  INSERT INTO search_docs (subject_kind, subject_id, ewe_id, season_id,
                           title, body, occurred_at)
  VALUES ('lambing', new.id, new.ewe, new.season,
          (SELECT e.tag FROM ewes e WHERE e.id = new.ewe) || ' ' || new.local_date,
          COALESCE(new.note, '') || ' ' || COALESCE(new.presentation_note, '')
            || ' ' || COALESCE(new.assisted_by, ''),
          new.occurred_at);
END;

CREATE TRIGGER lambings_search_au
AFTER UPDATE OF note, presentation_note, assisted_by, local_date ON lambings BEGIN
  UPDATE search_docs
     SET title = (SELECT e.tag FROM ewes e WHERE e.id = new.ewe) || ' ' || new.local_date,
         body = COALESCE(new.note, '') || ' ' || COALESCE(new.presentation_note, '')
                  || ' ' || COALESCE(new.assisted_by, '')
   WHERE subject_kind = 'lambing' AND subject_id = new.id;
END;

CREATE TRIGGER lambings_search_ad AFTER DELETE ON lambings BEGIN
  DELETE FROM search_docs WHERE subject_kind = 'lambing' AND subject_id = old.id;
END;

-- lambs. Title is the tag OR '' — a lamb that died before tagging is still
-- findable by its notes, and losing it here would lose exactly the losses that
-- matter most.
CREATE TRIGGER lambs_search_ai AFTER INSERT ON lambs BEGIN
  INSERT INTO search_docs (subject_kind, subject_id, ewe_id, season_id,
                           title, body, occurred_at)
  VALUES ('lamb', new.id, new.birth_dam,
          (SELECT l.season FROM lambings l WHERE l.id = new.lambing),
          COALESCE(new.tag, ''), COALESCE(new.notes, ''), new.created_at);
END;

CREATE TRIGGER lambs_search_au AFTER UPDATE OF tag, notes ON lambs BEGIN
  UPDATE search_docs SET title = COALESCE(new.tag, ''), body = COALESCE(new.notes, '')
   WHERE subject_kind = 'lamb' AND subject_id = new.id;
END;

CREATE TRIGGER lambs_search_ad AFTER DELETE ON lambs BEGIN
  DELETE FROM search_docs WHERE subject_kind = 'lamb' AND subject_id = old.id;
END;

-- treatments. Title is the product name; body is dose + batch + note.
CREATE TRIGGER treatments_search_ai AFTER INSERT ON treatments BEGIN
  INSERT INTO search_docs (subject_kind, subject_id, ewe_id, season_id,
                           title, body, occurred_at)
  VALUES ('treatment', new.id, new.ewe, new.season, new.product_name,
          COALESCE(new.dose_text, '') || ' ' || COALESCE(new.batch_no, '')
            || ' ' || COALESCE(new.note, ''),
          new.administered_at);
END;

CREATE TRIGGER treatments_search_au
AFTER UPDATE OF product_name, dose_text, batch_no, note ON treatments BEGIN
  UPDATE search_docs
     SET title = new.product_name,
         body = COALESCE(new.dose_text, '') || ' ' || COALESCE(new.batch_no, '')
                  || ' ' || COALESCE(new.note, '')
   WHERE subject_kind = 'treatment' AND subject_id = new.id;
END;

CREATE TRIGGER treatments_search_ad AFTER DELETE ON treatments BEGIN
  DELETE FROM search_docs WHERE subject_kind = 'treatment' AND subject_id = old.id;
END;

-- One MATCH, one bm25() ordering, one snippet(). The aliases are load-bearing:
-- drift names the generated result class from them, and an un-aliased
-- expression column produces a field nobody can reference.
searchAll:
SELECT
  d.id            AS doc_id,
  d.subject_kind  AS subject_kind,
  d.subject_id    AS subject_id,
  d.ewe_id        AS ewe_id,
  d.season_id     AS season_id,
  d.title         AS title,
  d.occurred_at   AS occurred_at,
  snippet(search_fts, 1, '[', ']', '…', 12) AS snippet
FROM search_fts f
JOIN search_docs d ON d.id = f.rowid
WHERE search_fts MATCH :query
ORDER BY bm25(search_fts), d.occurred_at DESC
LIMIT :limit;
